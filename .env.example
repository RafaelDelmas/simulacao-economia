# Copie para .env e ajuste se necessário
POSTGRES_DB=simulacao
POSTGRES_USER=simulacao
POSTGRES_PASSWORD=simulacao
POSTGRES_PORT=5432

# Usuário administrador padrão (criado automaticamente no primeiro boot)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Segredo usado para assinar os tokens JWT (troque em produção)
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRE_MINUTES=720
